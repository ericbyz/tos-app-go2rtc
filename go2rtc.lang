[zh-cn]
name = "go2rtc 摄像头流媒体中枢"
auth = "ericbyz"
descript = "把 IP 摄像头/媒体源转成 RTSP、低延迟 WebRTC 和 HLS,单二进制零依赖,内置 Web 管理页(http://<NAS>:18238)。浏览器里添加 rtsp:// 摄像头即可直播观看、两路对讲、录制回放。上游二进制原样封装(MIT),配置位于 /etc/go2rtc/go2rtc.yaml,摄像头流在 Web UI 里管理。"
note = "1. 将上游 AlexxIT/go2rtc(MIT)原样封装为 TOS 应用。"

[zh-hk]
name = "go2rtc 攝像頭流媒體中樞"
auth = "ericbyz"
descript = "把 IP 攝像頭/媒體源轉成 RTSP、低延遲 WebRTC 和 HLS,單二進制零依賴,內置 Web 管理頁(http://<NAS>:18238)。瀏覽器裡添加 rtsp:// 攝像頭即可直播觀看、兩路對講、錄製回放。"
note = "1. 将上游 AlexxIT/go2rtc(MIT)原样封装为 TOS 应用。"

[en-us]
name = "go2rtc Stream Hub"
auth = "ericbyz"
descript = "Camera streaming hub: turn IP cameras and media sources into RTSP, low-latency WebRTC and HLS with a single lightweight binary and an embedded web UI (http://<NAS>:18238). Add streams in the browser and watch live from anywhere. Packaged unmodified from upstream AlexxIT/go2rtc (MIT); config in /etc/go2rtc/go2rtc.yaml."
note = "1. Repackaged upstream AlexxIT/go2rtc (MIT) unmodified for TOS."

