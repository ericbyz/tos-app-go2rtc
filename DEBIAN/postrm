#!/bin/bash
set -e
APPID="go2rtc"
if [ "$1" = "purge" ]; then
    systemctl stop "go2rtc.service" 2>/dev/null || true
    id -u "${APPID}" >/dev/null 2>&1 && userdel "${APPID}" 2>/dev/null || true
    rm -rf /var/lib/go2rtc /etc/go2rtc /usr/local/go2rtc 2>/dev/null || true
    rm -f /etc/systemd/system/go2rtc.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
exit 0
